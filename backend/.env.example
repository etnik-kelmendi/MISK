# PostgreSQL connection. This value matches the local database started by `npm run db:dev`.
DATABASE_URL=postgres://postgres:postgres@localhost:5434/misk

# Port the API listens on.
PORT=3000

# Exact origin of the MISK web app. Other origins cannot call the API from a browser.
WEB_ORIGIN=http://localhost:5173

# IANA time zone of the city MISK serves. Booking slots and pros' working days use it.
MARKET_TIMEZONE=Europe/Berlin

# Folder for uploaded documents and photos. Back it up; it is not in the database.
UPLOAD_DIR=.uploads

# Set to true only when the API runs behind a trusted reverse proxy.
TRUST_PROXY=false

# Must be "production" in deployment. Production makes cookies HTTPS-only and requires Twilio.
NODE_ENV=development

LOG_LEVEL=info

# Card payments through Stripe Connect (https://dashboard.stripe.com). Required: the API will not start
# without them. Use test keys (sk_test_, pk_test_) everywhere except production.
# The webhook secret comes from the endpoint you add for <API URL>/payments/webhook, listening to
# payment_intent.amount_capturable_updated and payment_intent.payment_failed. For local testing run
# `stripe listen --forward-to localhost:3000/payments/webhook` and use the secret it prints.
# Never commit real values; put them in .env, which is not tracked.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Sign-in codes and job texts through Twilio (https://www.twilio.com). Set all three or none.
# Required in production. In development without them, sign-in codes are written to the API log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
