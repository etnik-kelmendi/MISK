{
  "name": "misk-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "db:dev": "tsx scripts/dev-db.ts",
    "migrate": "tsx --env-file=.env src/migrate-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "user:create-first-admin": "tsx --env-file=.env src/create-admin-cli.ts",
    "user:reset-password": "tsx --env-file=.env src/reset-password-cli.ts",
    "e2e:server": "tsx test/e2e-server.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.7",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.7",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "esbuild@0.28.2": true
  }
}
