# Base URL of the MISK API. Must be an absolute http or https URL.
VITE_API_BASE_URL=http://localhost:3000

# Terms of service and privacy policy, linked from the sign-in screen. Required before launch
# (see QUESTIONS.md Q7); the links are hidden while these are empty.
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# Map tiles for the live arrival map on the booking page (D83): a URL template with {z}, {x} and {y}.
# Empty uses OpenStreetMap (https://tile.openstreetmap.org/{z}/{x}/{y}.png); use your own tile provider for heavy traffic.
VITE_MAP_TILE_URL=
